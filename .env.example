PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Host development database only. Compose uses its own database and ignores this URL.
DATABASE_URL=
# Separate Compose database password. Use a new strong password; do not reuse tokens.
COMPOSE_POSTGRES_PASSWORD=
DEV_MERCHANT_TOKEN=
DEV_MERCHANT_ID=
# Separate disposable PostgreSQL database for integration tests.
TEST_DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AGENT_ENABLED=false
